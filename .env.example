# ==========================================
# SAPTHA SNPSU Portal — Environment Config
# ==========================================

# Server Environment (development | production)
SAPTHA_ENVIRONMENT=development
SAPTHA_HOST=127.0.0.1
SAPTHA_PORT=8000

# Trusted Origins (comma-separated list of allowed web portal origins)
SAPTHA_TRUSTED_ORIGINS=https://sapthasnpsuportal.vercel.app,http://127.0.0.1:8000,http://localhost:8000,http://127.0.0.1:5500,http://localhost:5500,http://127.0.0.1:3000,http://localhost:3000,http://127.0.0.1:5173,http://localhost:5173

# Firebase Configuration
SAPTHA_FIREBASE_DATABASE_URL=https://saptha-college-default-rtdb.firebaseio.com
# Path to service account JSON (e.g. ./service-account.json or ~/.config/saptha/firebase/service-account.json)
SAPTHA_FIREBASE_SERVICE_ACCOUNT_FILE=./service-account.json
# Or inline service account JSON string (useful for Vercel/Cloud deployment):
# SAPTHA_FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account",...}

# Google Drive Integration (Optional for notes upload)
# GOOGLE_DRIVE_ROOT_FOLDER_ID=your_drive_folder_id
# GOOGLE_OAUTH_CLIENT_ID=your_client_id.apps.googleusercontent.com
# GOOGLE_OAUTH_CLIENT_SECRET=your_client_secret
# GOOGLE_OAUTH_REFRESH_TOKEN=your_refresh_token
